# ---- عمومی ----
APP_ENV=production
APP_NAME=ProcessMaker
APP_DEBUG=false
APP_KEY=base64:XXLgKe/ZDRyZcEJU2SU4f7QPP/wcX5e8pdAqGOnsHhw=   # کلیدت رو از نصب اصلی کپی کن

# URL داخلی بین سرویس‌ها (داخل شبکه‌ی compose)
APP_URL=http://192.168.85.167:8080
PM4_API_URL=http://192.168.85.167:8080/api/1.0
DOCKER_HOST_URL=http://192.168.85.167:8080
FORCE_HTTPS=false

# ---- پایگاه داده ----
DB_DRIVER=mysql
DB_HOST=pm-db
DB_PORT=3306
DB_DATABASE=pm4
DB_USERNAME=pmuser
DB_PASSWORD=StrongPassword!

DATA_DB_DRIVER=mysql    
DATA_DB_HOST=pm-db
DATA_DB_PORT=3306
DATA_DB_DATABASE=pm4
DATA_DB_USERNAME=pmuser
DATA_DB_PASSWORD=StrongPassword!
DATA_DB_ENGINE=InnoDB

# ---- صف و کش ----
QUEUE_CONNECTION=redis
REDIS_HOST=pm-redis
REDIS_PASSWORD= 
REDIS_CLIENT=phpredis
REDIS_PREFIX=
HORIZON_PREFIX=horizon:

CACHE_STORE=array
#QUEUE_CONNECTION=sync
SESSION_DRIVER=file
                
# ---- تنظیمات اسکریپت و داکر ----
PROCESSMAKER_SCRIPTS_HOME=/var/www/html/storage/app
PROCESSMAKER_SCRIPTS_DOCKER=/usr/bin/docker
PROCESSMAKER_SCRIPTS_DOCKER_MODE=binding
# مهم: executorها روی همین شبکه بیفتند
PROCESSMAKER_SCRIPTS_DOCKER_PARAMS=--network=${COMPOSE_PROJECT_NAME}_default
CUSTOM_EXECUTORS=true

# ---- اسکریپت مایکروسرویس (غیرفعال) ----
SCRIPT_MICROSERVICE_ENABLED=false

# ---- زمان و فرمت ----
APP_TIMEZONE=UTC
DATE_FORMAT="m/d/Y H:i"

# ---- سشن و کوکی ----
SESSION_DOMAIN=bpms.fararoo.clickapps.ir
SESSION_SECURE_COOKIE=true

# ---- لاگ و پروکسی ----
API_TIMEOUT=5000
PROXIES=*
LOGOUT_OTHER_DEVICES=false
BROWSER_CACHE=true

# ---- رادیو/وب‌سوکت (برای echo server) ----
BROADCAST_DRIVER=redis
BROADCASTER_HOST=http://192.168.85.167:8080
BROADCASTER_KEY=changeme
LARAVEL_ECHO_SERVER_AUTH_HOST=http://192.168.85.167:8080
LARAVEL_ECHO_SERVER_HOST=0.0.0.0
LARAVEL_ECHO_SERVER_PORT=6001
LARAVEL_ECHO_SERVER_DEBUG=false
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_CLUSTER=
PUSHER_TLS=false
PUSHER_DEBUG=false

# ---- مسیرها ----
HOME=/var/www/html
